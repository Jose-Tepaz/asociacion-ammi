# Base de datos. Cada dev usa SU branch de Neon (dev-cesar, dev-andrea, ...); ver CLAUDE.md.
# Copia la cadena de conexión de tu branch desde la consola de Neon.
# Sin Neon, SQLite local: DATABASE_URL=file:./ammi.db
DATABASE_URL=

# true solo en tu branch personal: Payload sincroniza el esquema al correr pnpm dev.
# Nunca en production ni en Vercel.
PAYLOAD_DB_PUSH=false

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Neon Object Storage (archivos de Media). El almacenamiento se ramifica con la base:
# usa el endpoint y una credencial de TU branch, nunca los de production.
# Credenciales: neon credentials create --scope storage:read --scope storage:write
S3_ENDPOINT=https://br-xxxx.storage.c-8.us-east-2.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=uploades
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
