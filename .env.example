# Base de datos: la de producción en Neon (ver "Flujo de trabajo con Neon" en CLAUDE.md).
# Sin Neon, SQLite local: DATABASE_URL=file:./ammi.db
DATABASE_URL=

# Siempre false contra Neon: con true, pnpm dev modifica el esquema de producción
# y deja una fila `dev` que traba el build. Los cambios de esquema van por migraciones.
PAYLOAD_DB_PUSH=false

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Neon Object Storage (archivos de Media), el del branch production.
# Credenciales: neon credentials create --scope storage:read --scope storage:write
S3_ENDPOINT=https://br-xxxx.storage.c-8.us-east-2.aws.neon.tech
S3_REGION=us-east-2
S3_BUCKET=uploades
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
